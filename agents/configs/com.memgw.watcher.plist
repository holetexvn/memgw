<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: ~/Library/LaunchAgents/com.memgw.watcher.plist
     Load it with: launchctl load ~/Library/LaunchAgents/com.memgw.watcher.plist
     MEMGW_URL/MEMGW_KEY are read from ~/.memgw/env, so they are not declared here. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.memgw.watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/CHANGE_ME/.memgw/watcher.mjs</string>
    <string>--agent</string><string>codex</string>
    <string>--interval</string><string>60</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/memgw-watcher.log</string>
</dict>
</plist>
