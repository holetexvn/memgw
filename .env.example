# memgw configuration. Copy to ~/.memgw/env (local) or /opt/memgw/.env (server).
# `npx memgw start` generates this file for you, so you rarely need to start here.
# Precedence: process env > this file > built-in defaults.

# === required ===
# bearer token. Generate: openssl rand -hex 24
MEMGW_KEY=
# The server refuses to start without it.

# === LLM for the extraction worker (any OpenAI-compatible endpoint) ===
# without it, capture still works but no facts are extracted
MEMGW_LLM_API_KEY=
MEMGW_LLM_BASE_URL=https://api.openai.com/v1
# use a cheap model, this runs all day
MEMGW_LLM_MODEL=gpt-4o-mini
# en | vi -- facts come out in this language
MEMGW_PROMPT_LANG=en

# === semantic search (optional; easiest via `memgw embed on|off`) ===
# MEMGW_EMBED_MODEL=text-embedding-3-small   # empty = BM25 only
# MEMGW_EMBED_DIM=512

# === network ===
# 0.0.0.0 exposes it and then requires a 24+ char key
MEMGW_BIND=127.0.0.1
MEMGW_PORT=8930
MEMGW_MCP_PORT=8931
# path token for web clients that cannot send headers
MEMGW_MCP_SECRET=

# === paths ===
# MEMGW_HOME=~/.memgw
# MEMGW_DATA_DIR=~/.memgw/data  # the database follows this unless MEMGW_DB_PATH is set
# MEMGW_DB_PATH=

# === worker cadence ===
# 15 minutes: events -> facts
MEMGW_WORKER_INTERVAL_MS=900000
# 6 hours: facts -> notes (the expensive one)
MEMGW_NOTES_INTERVAL_MS=21600000
# delete raw events older than this; 0 disables
MEMGW_RETENTION_DAYS=90

# === backup (optional) ===
# MEMGW_GIT_REMOTE=https://<token>@github.com/you/memgw-data.git
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# === testing ===
# MEMGW_LLM_MOCK=1              # run the full pipeline without an API key
